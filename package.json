{
  "name": "showupsats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "seed": "tsx prisma/seed.ts",
    "hold-test": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 tsx scripts/hold-test.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "e2e": "NODE_USE_ENV_PROXY=1 tsx scripts/e2e-flow.ts",
    "wallets": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 tsx scripts/faucet.ts"
  },
  "dependencies": {
    "@getalby/bitcoin-connect": "^3.12.3",
    "@getalby/lightning-tools": "^10.0.0",
    "@getalby/sdk": "^9.0.0",
    "@prisma/client": "^6.19.3",
    "https-proxy-agent": "^9.1.0",
    "next": "^15.5.29",
    "nostr-tools": "^2.26.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}