DATABASE_URL="file:./dev.db"
ENCRYPTION_KEY=          # 32-byte base64, for AES-256-GCM of NWC URIs and preimages (openssl rand -base64 32)
APP_NOSTR_NSEC=          # app signing key for receipts and records (nsec1...)
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
ACCEPT_WINDOW_MINUTES=10
NO_SHOW_GRACE_MINUTES=15
STYLIST_REFUND_DEADLINE_HOURS=24
DEMO_MODE=0
# Faucet wallets give one full-access connection. Set to 1 ONLY with faucet test wallets
# to let the demo provider use it as connection A (UI shows a warning). Never in production.
ALLOW_TEST_FULL_ACCESS_NWC=0
# Optional: seed the demo provider with real test wallet connections
SEED_NWC_RECEIVE_URI=
SEED_NWC_REFUND_URI=
CRON_SECRET=
